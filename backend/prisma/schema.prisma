// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logo        String?
  config      Json?
  plan        String   @default("FREE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]
  members     Member[]
  donations   Donation[]
  campaigns   Campaign[]
  species     Species[]
  missions    Mission[]
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  email          String
  passwordHash   String?  // null cuando el user es solo OAuth (sin password local)
  role           String   @default("VIEWER")
  isActive       Boolean  @default(true)
  emailVerified  Boolean  @default(false)
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id])
  oauthAccounts  OAuthAccount[]
  refreshTokens  RefreshToken[]

  @@unique([organizationId, email])
  @@index([email])
}

model Member {
  id             String   @id @default(uuid())
  organizationId String
  rut            String?  // RUT chileno
  firstName      String
  lastName       String
  email          String
  phone          String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  donations      Donation[]

  @@unique([organizationId, rut])
}

model Donation {
  id              String   @id @default(uuid())
  organizationId  String
  memberId        String?
  campaignId      String?
  amount          Decimal  @db.Decimal(15, 2)
  currency        String   @default("CLP")
  status          String   @default("PENDING") // PENDING, SUCCEEDED, FAILED
  recurringStatus String?  // ACTIVE, PAUSED, CANCELLED
  gatewayRef      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  member          Member?      @relation(fields: [memberId], references: [id])
  campaign        Campaign?    @relation(fields: [campaignId], references: [id])
}

model Campaign {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  goalAmount      Decimal  @db.Decimal(15, 2)
  currentAmount   Decimal  @default(0) @db.Decimal(15, 2)
  startDate       DateTime @default(now())
  endDate         DateTime?
  status          String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  donations       Donation[]
}

model Species {
  id              String   @id @default(uuid())
  organizationId  String
  commonName      String
  scientificName  String?
  description     String?
  imageUrl        String?
  status          String   @default("ACTIVE") // ACTIVE, THREATENED, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
}

model Mission {
  id              String   @id @default(uuid())
  organizationId  String
  title           String
  description     String?
  location        String?
  status          String   @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, CANCELLED
  startDate       DateTime @default(now())
  endDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  tasks           MissionTask[]
}

model MissionTask {
  id              String   @id @default(uuid())
  missionId       String
  title           String
  description     String?
  isCompleted     Boolean  @default(false)
  assignedTo      String?  // Puede ser un Member ID o nombre
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mission         Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model DemoRequest {
  id          String   @id @default(uuid())
  name        String
  email       String
  org         String   // Nombre de la ONG/organización del lead
  phone       String?
  message     String?
  status      String   @default("NEW") // NEW, CONTACTED, QUALIFIED, ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Vincula un User con su identidad en un provider externo (Google, Facebook, GitHub).
// Un User puede tener varias OAuthAccount (multi-provider linking).
model OAuthAccount {
  id              String   @id @default(uuid())
  userId          String
  provider        String   // 'google' | 'facebook' | 'github'
  providerUserId  String   // ID estable que entrega el provider para este user
  providerEmail   String?  // Email que el provider devolvió al momento del link
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([providerEmail])
}

// Refresh tokens persistidos (db-backed para permitir revocación en logout).
// El client recibe el token plano; acá guardamos solo el hash SHA-256.
model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  userAgent   String?
  ipAddress   String?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

