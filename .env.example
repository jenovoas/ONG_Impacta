# Impacta+ — variables de entorno
#
# En producción este archivo vive solo en Fenix y Docker Compose lo usa para
# inyectar secretos al backend. Nunca sincronizarlo al frontend de Kingu.
#
# Para desarrollo local: cp .env.example .env  y completa los valores.

# --- Seguridad ---
JWT_SECRET=            # requerido — secreto de firma JWT (openssl rand -base64 48)

# --- Base de datos / cache ---
# Desarrollo local usa impacta_pass. En Fenix define un secreto y sincronízalo
# con el rol PostgreSQL existente antes de actualizar la URL del contenedor.
POSTGRES_PASSWORD=impacta_pass
DATABASE_URL=postgresql://impacta:impacta_pass@127.0.0.1:5432/impacta?schema=public
DATABASE_URL_DOCKER=postgresql://impacta:impacta_pass@postgres:5432/impacta?schema=public
REDIS_URL=redis://127.0.0.1:6379/0

# --- Runtime ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
APP_PUBLIC_URL=https://impacta.pinguinoseguro.cl   # base pública para links salientes (p.ej. paymentUrl)

# --- Observabilidad (opcional; si se configura, enviar también logs a Loki) ---
# Usa HTTPS si Loki requiere autenticación básica.
LOKI_HOST=
LOKI_USERNAME=
LOKI_PASSWORD=

# --- IA gateway (OmniRoute local en fenix) ---
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_MODEL=auto
OMNIROUTE_TIMEOUT_MS=30000
OMNIROUTE_API_KEY=          # opcional; nunca ponerlo en el frontend

# --- OAuth (opcional; si se definen, se habilitan los providers) ---
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
